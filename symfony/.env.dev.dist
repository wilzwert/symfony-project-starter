APP_ENV=dev
APP_DEBUG=1

###> symfony/framework-bundle ###
APP_SECRET=
###< symfony/framework-bundle ###

APP_URL=http://localhost:8080

# DSN to your postgresql database ;
# Do not edit this line if you're using Docker the provided /docker/dev/docker-compose.yaml as is
# Username, password, server name and db name must reflect the values id docker/dev/docker-compose.yaml
DATABASE_URL="postgresql://my-awesome-app:!ChangeThisAwesomeSecret!@my-awesome-app-db:5432/my-awesome-app?serverVersion=16&charset=utf8"

# DSN to your redis server ;
# Do not edit this line if you're using Docker the provided /docker/dev/docker-compose.yaml as is
REDIS_URL=redis://my-awesome-app-redis
